+static VkSubresourceLayout plane_layout( CVulkanTexture *pTexture, VkImageAspectFlagBits ePlane )
+{
+	const VkImageSubresource subresource = { .aspectMask = VkImageAspectFlags( ePlane ) };
+	VkSubresourceLayout layout = {};
+	g_device.vk.GetImageSubresourceLayout( g_device.device(), pTexture->vkImage(), &subresource, &layout );
+	return layout;
+}
