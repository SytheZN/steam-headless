+VkBuffer CVulkanTexture::dmabufBufferAlias()
+{
+	if ( m_dmabufAliasBuffer != VK_NULL_HANDLE || m_dmabuf.n_planes < 1 )
+		return m_dmabufAliasBuffer;
+
+	const VkExternalMemoryBufferCreateInfo externalInfo = {
+		.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	const VkBufferCreateInfo bufferInfo = {
+		.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+		.pNext = &externalInfo,
+		.size = m_size,
+		.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+	};
+	VkBuffer buffer = VK_NULL_HANDLE;
+	VkResult res = g_device.vk.CreateBuffer( g_device.device(), &bufferInfo, nullptr, &buffer );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "dmabuf alias vkCreateBuffer failed" );
+		return VK_NULL_HANDLE;
+	}
+
+	VkMemoryRequirements memRequirements;
+	g_device.vk.GetBufferMemoryRequirements( g_device.device(), buffer, &memRequirements );
+
+	const int fd = dup( m_dmabuf.fd[0] );
+	if ( fd < 0 )
+	{
+		vk_log.errorf_errno( "dmabuf alias dup failed" );
+		g_device.vk.DestroyBuffer( g_device.device(), buffer, nullptr );
+		return VK_NULL_HANDLE;
+	}
+
+	VkMemoryFdPropertiesKHR fdProperties = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+	};
+	res = g_device.vk.GetMemoryFdPropertiesKHR( g_device.device(), VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fdProperties );
+	const uint32_t uImportableTypes = res == VK_SUCCESS ? memRequirements.memoryTypeBits & fdProperties.memoryTypeBits : 0;
+
+	int32_t nMemoryType = g_device.findMemoryType( VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, uImportableTypes );
+	if ( nMemoryType < 0 )
+		nMemoryType = g_device.findMemoryType( 0, uImportableTypes );
+	if ( nMemoryType < 0 )
+	{
+		vk_log.errorf( "dmabuf alias: no importable memory type" );
+		close( fd );
+		g_device.vk.DestroyBuffer( g_device.device(), buffer, nullptr );
+		return VK_NULL_HANDLE;
+	}
+
+	VkImportMemoryFdInfoKHR importInfo = {
+		.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+		.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+		.fd = fd,
+	};
+	const VkMemoryAllocateInfo allocInfo = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		.pNext = &importInfo,
+		.allocationSize = memRequirements.size,
+		.memoryTypeIndex = uint32_t( nMemoryType ),
+	};
+	VkDeviceMemory memory = VK_NULL_HANDLE;
+	res = g_device.vk.AllocateMemory( g_device.device(), &allocInfo, nullptr, &memory );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "dmabuf alias vkAllocateMemory failed" );
+		close( fd );
+		g_device.vk.DestroyBuffer( g_device.device(), buffer, nullptr );
+		return VK_NULL_HANDLE;
+	}
+
+	res = g_device.vk.BindBufferMemory( g_device.device(), buffer, memory, 0 );
+	if ( res != VK_SUCCESS )
+	{
+		vk_errorf( res, "dmabuf alias vkBindBufferMemory failed" );
+		g_device.vk.FreeMemory( g_device.device(), memory, nullptr );
+		g_device.vk.DestroyBuffer( g_device.device(), buffer, nullptr );
+		return VK_NULL_HANDLE;
+	}
+
+	m_dmabufAliasBuffer = buffer;
+	m_dmabufAliasMemory = memory;
+	return m_dmabufAliasBuffer;
+}
