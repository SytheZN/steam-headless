+static void copy_nv12_to_export( CVulkanCmdBuffer *pCmdBuffer, gamescope::Rc<CVulkanTexture> pSource, gamescope::Rc<CVulkanTexture> pExport )
+{
+	const uint32_t uWidth = pExport->width();
+	const uint32_t uHeight = pExport->height();
+
+	VkBuffer exportBuffer = pExport->dmabufBufferAlias();
+	if ( exportBuffer == VK_NULL_HANDLE )
+	{
+		const VkImageCopy planes[2] = {
+			{
+				.srcSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_0_BIT, .layerCount = 1 },
+				.dstSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_0_BIT, .layerCount = 1 },
+				.extent = { uWidth, uHeight, 1 },
+			},
+			{
+				.srcSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_1_BIT, .layerCount = 1 },
+				.dstSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_1_BIT, .layerCount = 1 },
+				.extent = { uWidth / 2, uHeight / 2, 1 },
+			},
+		};
+		pCmdBuffer->copyImageRegions( pSource, pExport, planes );
+		return;
+	}
+
+	const VkSubresourceLayout lumaLayout = plane_layout( pExport.get(), VK_IMAGE_ASPECT_PLANE_0_BIT );
+	const VkSubresourceLayout chromaLayout = plane_layout( pExport.get(), VK_IMAGE_ASPECT_PLANE_1_BIT );
+	const VkBufferImageCopy planes[2] = {
+		{
+			.bufferOffset = lumaLayout.offset,
+			.bufferRowLength = uint32_t( lumaLayout.rowPitch ),
+			.imageSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_0_BIT, .layerCount = 1 },
+			.imageExtent = { uWidth, uHeight, 1 },
+		},
+		{
+			.bufferOffset = chromaLayout.offset,
+			.bufferRowLength = uint32_t( chromaLayout.rowPitch / 2 ),
+			.imageSubresource = { .aspectMask = VK_IMAGE_ASPECT_PLANE_1_BIT, .layerCount = 1 },
+			.imageExtent = { uWidth / 2, uHeight / 2, 1 },
+		},
+	};
+	pCmdBuffer->copyImageToExternalBuffer( pSource, exportBuffer, planes );
+}
